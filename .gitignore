# 依赖
node_modules/

# Electron 打包产物（electron-builder 输出）
dist/
out/

# 构建产物不入库：server jar 由 agent-team-server 构建后同步，jre 由 scripts 裁剪，web 由 web/ 子项目构建到 web/dist（见 README）
resources/server/*
!resources/server/.gitkeep
resources/jre/
# 托盘图标以 build/icon.ico 为唯一来源（开发态直接读 build/，打包态经 extraResources 复制）
# icon.ico 与 icon.png 均入库：ico 由 scripts/build-icon.js 从 png 生成，勿删
resources/icon.ico

# 日志
*.log
.idea
